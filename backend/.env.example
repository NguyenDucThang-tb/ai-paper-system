# APP
APP_NAME=ai-paper-system
ENV=production

# SECURITY
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_TOKEN=

# DATABASE
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Neo4j for user-uploaded document graph (ingestion / RAG graph retrieval)
NEO4J_URI=neo4j+s://6d37f1fa.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=I3Pzsg1gvUw2BCFsp3A6CjuhjjY9XIun1Fp6dsYJo3s
NEO4J_DATABASE=neo4j
NEO4J_USER_DOC_DB=neo4j
AURA_INSTANCEID=6d37f1fa
AURA_INSTANCENAME=My instance

# Neo4j for global recommendation graph
NEO4J_REC_URI=neo4j+s://65e82d44.databases.neo4j.io
NEO4J_REC_USER=65e82d44
NEO4J_REC_USERNAME=65e82d44
NEO4J_REC_PASSWORD=76VhdpIq2of0DEJvrRlbtiW4N-FdMaq1rv6RB4dvvbM
NEO4J_REC_DATABASE=65e82d44
NEO4J_REC_AURA_INSTANCEID=65e82d44
NEO4J_REC_AURA_INSTANCENAME=Instance01

# OLLAMA (remote model server)
OLLAMA_BASE_URL=http://n2.ckey.vn:2679
OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b-instruct-fp16
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=180

# Ingestion lock (hard guard for metadata extraction)
INGESTION_LOCKED_OLLAMA_BASE_URL=http://n2.ckey.vn:2679
INGESTION_LOCKED_OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
INGESTION_LOCKED_OLLAMA_MODEL=qwen2.5:7b-instruct-fp16

# AI MODULE LLM BACKEND (used by summarize/qa/kg/recommendation)
LLM_BACKEND=vllm
VLLM_BASE_URL=http://n2.ckey.vn:2679
VLLM_MODEL_NAME=qwen2.5:7b-instruct-fp16
VLLM_TIMEOUT_SECONDS=180

# GPU enforcement (ingestion OCR + ai_module)
STRICT_GPU=true
DEVICE=cuda

# Ingestion OCR
OCR_BACKEND=remote
OCR_ENGINE=auto
OCR_DPI=96
OCR_BASE_URL=http://n2.ckey.vn:2679
OCR_REMOTE_ENDPOINT=/v1/chat/completions
OCR_REMOTE_MODEL_NAME=qwen2.5:7b-instruct-fp16
OCR_TIMEOUT_SECONDS=120
OCR_REMOTE_CONCURRENCY=2
OCR_REMOTE_API_KEY=
OCR_FORCE_ALL_PAGES=false

# EMBEDDING (local | remote)
EMBEDDING_BACKEND=remote
EMBEDDING_BASE_URL=http://n2.ckey.vn:2679
EMBEDDING_REMOTE_MODEL_NAME=qwen2.5:7b-instruct-fp16
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_DEVICE=cuda

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# FRONTEND/CORS
FRONTEND_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# SMTP (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# FASTAPI-MAIL
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
