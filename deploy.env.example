# Public URLs
PUBLIC_API_BASE_URL=https://your-domain/api/v1
PUBLIC_FRONTEND_URL=https://your-domain

# Backend
ENV=production
SECRET_KEY=replace-with-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_TOKEN=replace-with-internal-token
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Force AI requests to remote GPU server
LLM_BACKEND=vllm
VLLM_BASE_URL=http://n3.ckey.vn:2409
VLLM_MODEL_NAME=qwen2.5:7b-instruct-q8_0
VLLM_TIMEOUT_SECONDS=180
STRICT_GPU=false
DEVICE=cpu

# Optional (legacy compatibility)
OLLAMA_BASE_URL=http://n3.ckey.vn:2409
OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b-instruct-q8_0
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# App URLs & CORS
FRONTEND_APP_URL=https://your-domain
CORS_ALLOWED_ORIGINS=https://your-domain,http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/auth/google/callback

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
