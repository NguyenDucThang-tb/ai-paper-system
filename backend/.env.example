# APP
APP_NAME=ai-paper-system
ENV=production

# SECURITY
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_TOKEN=

# DATABASE
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Neo4j for user-uploaded document graph (ingestion / RAG graph retrieval)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Neo4j for global recommendation graph loaded from neo4j.dump
NEO4J_REC_URI=bolt://neo4j-rec:7687
NEO4J_REC_USER=neo4j
NEO4J_REC_PASSWORD=password
NEO4J_REC_DATABASE=neo4j

# OLLAMA (remote model server)
OLLAMA_BASE_URL=http://n3.ckey.vn:2409
OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b-instruct-q8_0
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# AI MODULE LLM BACKEND (used by summarize/qa/kg/recommendation)
LLM_BACKEND=vllm
VLLM_BASE_URL=http://n3.ckey.vn:2409
VLLM_MODEL_NAME=qwen2.5:7b-instruct-q8_0
VLLM_TIMEOUT_SECONDS=180

# GPU enforcement (ingestion OCR + ai_module)
STRICT_GPU=false
DEVICE=cpu

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# FRONTEND/CORS
FRONTEND_APP_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# FASTAPI-MAIL
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
